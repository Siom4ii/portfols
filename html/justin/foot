.footer {
  background: #2D2D2D;
  color: #ddd;
  padding: 40px 60px;
  font-family: Arial, sans-serif;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.footer-col {
  flex: 1;
  min-width: 200px;
  margin: 10px;
}

.footer h3 {
  color: #fff;
  margin-bottom: 15px;
}

.footer p {
  line-height: 1.6;
  font-size: 14px;
}

.footer .logo {
  margin-top: 10px;
  font-weight: bold;
}

.footer ul {
  list-style: none;
  padding: 0;
}

.footer ul li {
  margin: 8px 0;
}

.footer ul li a {
  color: #ddd;
  text-decoration: none;
  font-size: 14px;
}

.footer ul li a:hover {
  color: #fff;
}

.socials {
  display: flex;
  justify-content: center;  /* Center the icons */
  align-items: center;      /* Align vertically */
  gap: 20px;                /* Space between icons */
  margin-top: 10px;
  margin-right: 180px;
}

.socials img {
  width: 40px;              /* Icon size */
  height: 40px;
  border-radius: 50%;       /* Optional: circular icons */
  object-fit: cover;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.socials img:hover {
  transform: scale(1.2);
}



.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.2);
  padding-top: 15px;
  text-align: center;
  font-size: 13px;
  color: #aaa;
}

.footer-bottom a {
  color: #aaa;
  text-decoration: none;
  margin: 0 5px;
}

.footer-bottom a:hover {
  color: #fff;
}

